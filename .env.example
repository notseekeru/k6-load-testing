# Copy to .env. A value exported in the shell wins over this file, and --api-url wins over both.
API_URL=https://host/api

# Level size for a direct `k6 run main.js`. The driver sets this per level and ignores it.
TARGET_VUS=100

# Turns per run, each bounded by the run's own plan so the server never refuses a turn.
TURNS_MIN=2
TURNS_MAX=8

# Pause before an answer, in seconds.
THINK_MIN_S=1
THINK_MAX_S=3

# Bearer token, blank when the target takes none.
TOKEN=

# Host override, for an ingress that routes by name.
HOST_HEADER=

# The sweep's own identity, so the cleanup deletes only the run's rows. --sweep-sub wins over this.
SWEEP_SUB=

# Phase lengths. --smoke rewrites these for a harness check; a run for the record leaves them alone.
RAMP_S=30
WARM_S=60
MEASURE_S=300
