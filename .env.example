# Copy to .env. A value exported in the shell wins over this file, and --api-url wins over both.
# Values are literal: no export prefix, quotes or interpolation.
API_URL=https://host/api

# Level size for a direct `k6 run main.js`. The driver sets this per level and ignores it.
TARGET_VUS=100

# Turns per run, each bounded by the run's own plan so the server never refuses a turn.
TURNS_MIN=2
TURNS_MAX=8

# Pause before an answer, in seconds.
THINK_MIN_S=1
THINK_MAX_S=3

# Bearer token, blank when the target takes none.
TOKEN=

# Host override, for an ingress that routes by name.
HOST_HEADER=

# A target behind a self-signed certificate needs K6_INSECURE_SKIP_TLS_VERIFY=true beside these.

# The sweep's own identity, so the cleanup deletes only the run's rows. --sweep-sub wins over this.
SWEEP_SUB=

# A short tag for the run's configuration, e.g. pool40-nodeport. --label wins over this. Written to
# every row, so a CSV names the build, pool and path it measured.
LABEL=

# Grafana read for the same window: pool wait, query time and pool size. Unset token leaves those
# columns blank and names the reason in db_note.
GRAFANA_URL=https://sturdypoplar3317.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=
PROM_DS=grafanacloud-prom
APP_LABEL=maxterview-backend

# Phase lengths. --smoke rewrites these for a harness check; a run for the record leaves them alone.
# A confirmation is measured for sweep.py's CONFIRM_MEASURE_S instead.
RAMP_S=30
WARM_S=60
MEASURE_S=120
