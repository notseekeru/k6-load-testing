# Copy to .env. A value exported in the shell wins over this file.
API_URL=https://host/api
TARGET_VUS=25
TURNS_MIN=2
TURNS_MAX=8
THINK_MIN_S=1
THINK_MAX_S=3
# Bearer token, blank when the target takes none.
TOKEN=
# Host override, for an ingress that routes by host.
HOST_HEADER=
# Phase lengths. The driver rewrites these for --smoke; a run for the record leaves them alone.
RAMP_S=30
WARM_S=60
MEASURE_S=300
